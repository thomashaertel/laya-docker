# ─── Laya Decision API — example environment file ───────────────────────────
# Copy to .env and fill in values before starting the container.
#
#   cp .env.example .env
#   docker compose up -d --build
# ─────────────────────────────────────────────────────────────────────────────


# ── Auth (required) ──────────────────────────────────────────────────────────
# Shared Bearer token every client must send in the Authorization header.
# Leave blank to auto-generate a random key at startup (printed to logs once).
# TypeSafe SDK users: set TYPESAFE_API_KEY=<same value> on the client side.
LAYA_API_KEY=change-me


# ── Model (optional) ─────────────────────────────────────────────────────────
# Default checkpoint used when a request omits the "model" field.
#
#   laya-multilingual     322 M  mmBERT-base     100+ languages  1 024-token ctx  ← default
#   laya-english          421 M  ModernBERT-lg   English only      512-token ctx
#   laya-typed-decisions  421 M  ModernBERT-lg   English, workflow-tuned
#
# Aliases also accepted: laya | default | jev-latest  (all → laya-multilingual)
LAYA_MODEL=laya-multilingual


# ── Workers (optional) ────────────────────────────────────────────────────────
# Number of Uvicorn worker processes.
# Each worker loads the model independently — budget ~700 MB VRAM per worker
# for laya-multilingual, ~850 MB for the English/typed-decisions checkpoints.
# Good starting points: 2 for a single GPU node, 4 for high-core / high-memory.
UVICORN_WORKERS=2


# ── ROCm GPU override (optional) ─────────────────────────────────────────────
# Required for consumer AMD GPUs not on ROCm's official support list.
# Uncomment the line that matches your GPU family:
#
#   RDNA2  — RX 6000 series (gfx1030)
# HSA_OVERRIDE_GFX_VERSION=10.3.0
#
#   RDNA3  — RX 7000 series (gfx1100 / gfx1101 / gfx1102)
# HSA_OVERRIDE_GFX_VERSION=11.0.0
#
#   CDNA2  — Instinct MI200 series
# HSA_OVERRIDE_GFX_VERSION=9.0.10


# ── HuggingFace cache (optional) ─────────────────────────────────────────────
# Path inside the container where model weights are cached.
# The docker-compose.yml mounts the named volume "laya-models" here.
# Change only if you need to override the mount point.
HF_HOME=/models


# ── TypeSafe SDK (client-side reminder) ──────────────────────────────────────
# On the machine running your TypeSafe SDK integration, set:
#   TYPESAFE_BASE_URL=http://<host>:8000
#   TYPESAFE_API_KEY=<same value as LAYA_API_KEY above>
# No code changes needed — the SDK will call /v1/systemone on this server.
