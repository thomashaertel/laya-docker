# ─── Laya Decision Model — NVIDIA CUDA ───────────────────────────────────────
# Base: official PyTorch image with CUDA 12.4 + cuDNN 9.
# Same app.py and requirements.txt as the ROCm variant.
#
# Usage:
#   docker compose -f docker-compose.nvidia.yml up -d --build
#
# Host requirements:
#   - NVIDIA driver >= 550 (for CUDA 12.4)
#   - nvidia-container-toolkit installed and Docker runtime configured
#     https://docs.nvidia.com/datacenter/cloud-native/container-toolkit/install-guide.html
# ─────────────────────────────────────────────────────────────────────────────
FROM pytorch/pytorch:2.5.1-cuda12.4-cudnn9-runtime

# ── System deps ───────────────────────────────────────────────────────────────
RUN apt-get update && apt-get install -y --no-install-recommends \
    git curl \
 && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# ── Python deps ───────────────────────────────────────────────────────────────
# Same guard as the ROCm Dockerfile: install everything except laya first so
# pip cannot replace the CUDA torch from the base image with a CPU wheel.
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt
RUN pip install --no-cache-dir --no-deps laya

# Smoke-test: confirm CUDA torch survived
RUN python -c "import torch; v=torch.__version__; cuda=torch.version.cuda or 'none'; \
    print(f'torch={v}  CUDA={cuda}'); assert cuda!='none', 'CUDA torch not found!'"

# ── Application ───────────────────────────────────────────────────────────────
COPY app.py .
COPY entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

ENV HF_HOME=/models
EXPOSE 8000

ENTRYPOINT ["/entrypoint.sh"]
CMD uvicorn app:app \
    --host 0.0.0.0 \
    --port ${UVICORN_PORT:-8000} \
    --workers ${UVICORN_WORKERS:-1} \
    --timeout-keep-alive 75 \
    --access-log
